# ThreatGraph Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=threatgraphpassword

# PostgreSQL Cyber-Range Asset Credentials
POSTGRES_DB=customer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=threatgraphdb

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
TARGET_SUBNET=10.10.10.0/24

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
